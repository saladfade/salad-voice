# TTS server: audio.cpp (Qwen3-TTS 1.7B Base, CPU backend)
# Model and default voice are baked into the image — no host model storage needed.
#
# Build:  docker build -f Dockerfile.tts -t salad-tts .
# Run:    docker run --rm -p 8082:8080 salad-tts
FROM ghcr.io/0xshug0/audio.cpp:full-cpu

# Qwen3-TTS 1.7B Base GGUF (audio.cpp-native format, q8_0)
RUN mkdir -p /models/Qwen3-TTS-12Hz-1.7B-Base-GGUF && \
    curl -fsSL -o /models/Qwen3-TTS-12Hz-1.7B-Base-GGUF/qwen3-tts-12hz-1.7b-base-q8_0_v2.gguf \
    "https://huggingface.co/audio-cpp/audio.cpp-gguf/resolve/main/Qwen3-TTS-12Hz-1.7B-Base-GGUF/qwen3-tts-12hz-1.7b-base-q8_0_v2.gguf"

# Default voice reference (used for plain TTS when no voice is supplied)
COPY voice/b.wav /voices/b.wav

COPY server.json /app/server.json

EXPOSE 8080
CMD ["server", "--config", "/app/server.json", "--backend", "cpu"]
